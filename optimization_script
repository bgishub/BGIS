bgi_retention = {bgi: BGI_CATALOG[bgi]['water_storage_volume'] for bgi in BGI_CATALOG}
bgi_capex = {bgi: BGI_CATALOG[bgi]['CAPEX'] for bgi in BGI_CATALOG}

