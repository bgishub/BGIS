def compute_polygon_impact(solution_df):
    df = solution_df.copy()
    for col in ['water_storage_volume', 'temperature_reduction', 'CAPEX']:
        df[col] = 0.0
    mask = df['selected_bgi'].notna()
    if not mask.any():
        print("no selections made")
        return df
        
    bgi_series = df.loc[mask, 'selected_bgi']
    area_series = df.loc[mask, 'selected_bgi_area']

    df.loc[mask, 'water_storage_volume'] = bgi_series.map(
        lambda x: BGI_CATALOG[x].get('water_storage_volume', 0)
    ) * area_series
    df.loc[mask, 'temperature_reduction'] = bgi_series.map(
        lambda x: BGI_CATALOG[x].get('temperature_reduction', 0)
    ) * area_series
    df.loc[mask, 'CAPEX'] = bgi_series.map(
        lambda x: BGI_CATALOG[x].get('CAPEX', 0)
    ) * area_series
    return df



def solution_summary(input_df):
    total_area = input_df['area_m2'].sum()
    solution_df = compute_polygon_impact(input_df)
    solution_use_area = solution_df["selected_bgi_area"].sum()
    print(f"out of {total_area:,.0f} m2 of land, {(solution_use_area/total_area)*100:.2f}% is used")

    solution_sum_retention = solution_df["water_storage_volume"].sum() 
    solution_sum_cooling = solution_df["temperature_reduction"].sum()

    print(f"average retention of {solution_sum_retention/total_area:,.2f} m depth, \
    {solution_sum_retention/total_theoretical_storage*100:.2f}% of maximum capability")

    print(f"average cooling of {solution_sum_cooling/total_area:,.2f} degC, \
     {solution_sum_cooling/total_theoretical_cooling*100:.2f}% of maximum capability")

    total_cost = solution_df["CAPEX"].sum()
    print(f"at a cost of {total_cost:,.2f}")
    return

