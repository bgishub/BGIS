##################################################################################
# FUNCTION: remove cells with BGI already installed
#           set maximum area of application  
##################################################################################
def prepare_gdf(input_gdf):
    gdf = input_gdf.copy()
# strip polygons with installations 
    if "selected_bgi" in gdf.columns:
        gdf = gdf[gdf["selected_bgi"].isna()].copy()
    gdf = gdf.reset_index(drop=True)
# build area_cap 
    area_cap = {}
    for row in gdf.itertuples():
        idx = row.Index
        for bgi in row.suitable_bgis:
            if bgi not in BGI_CATALOG:
                raise KeyError(f"missing BGI key, {bgi}")
            cap = min(
                row.area_m2,
                BGI_CATALOG[bgi].get('area_max', float('inf'))
            )
            if cap > 0:
                area_cap[(idx, bgi)] = cap
    return gdf, area_cap

##################################################################################
# FUNCTION: FIND MAXIMUM THEORETICAL PERFORMANCE                                           
# when multi-objective, normalize performance by max theoretical of single objective
##################################################################################
def maximum_theoretical_performance(input_gdf):
    gdf, area_cap = prepare_gdf(input_gdf)
    total_area = gdf["area_m2"].sum()
    if total_area <=0:
        raise ValueError("invalid area")

    # find maximum theoretical performance of single objectives 
    max_single_cooling = {idx: 0 for idx in gdf.index}
    max_single_retention = {idx: 0 for idx in gdf.index}
    for (idx, bgi), area in area_cap.items():
        cooling_value = area * BGI_CATALOG[bgi]['temperature_reduction']
        max_single_cooling[idx] = max(max_single_cooling[idx], cooling_value)
        retention_value = area * BGI_CATALOG[bgi]['water_storage_volume']
        max_single_retention[idx] = max(max_single_retention[idx], retention_value)
    
    total_theoretical_cooling = sum(max_single_cooling.values())
    total_theoretical_retention = sum(max_single_retention.values())
    
    print(f"max cooling in C per area m2: {total_theoretical_cooling/total_area:.3f}")
    print(f"max storage in depth m per area m2: {total_theoretical_retention/total_area:.3f}")
    print(f"total area in m2: {total_area:.2f}")

    if total_theoretical_cooling <= 0:
        raise ValueError("invalid total cooling")

    if total_theoretical_retention <= 0:
        raise ValueError("invalid total retention")
    
    # define binary decision variables
    variables = {
        (idx, bgi): LpVariable(f"x_{idx}_{bgi}", cat="Binary")
        for (idx, bgi) in area_cap
    }

    # define the problem
    prob = LpProblem("Maximum_Performance", LpMaximize)

    # define cooling and retention expressions
    total_optimized_cooling = lpSum(
        variables[(idx, bgi)] * area_cap[(idx, bgi)] * bgi_cooling[bgi]
        for (idx, bgi) in variables
    )

    total_optimized_retention = lpSum(
        variables[(idx, bgi)] * area_cap[(idx, bgi)] * bgi_retention[bgi]
        for (idx, bgi) in variables
    )
    
    # constraint: 1 BGI placed per cell 
    for idx in gdf.index:
        prob += lpSum(
            variables[(idx, bgi)]
            for bgi in gdf.at[idx, "suitable_bgis"]
            if (idx, bgi) in variables
        ) <= 1

    # define objective
    prob += total_optimized_cooling/total_theoretical_cooling + total_optimized_retention/total_theoretical_retention

    # solve 
    start_time = time.time()
    prob.solve(PULP_CBC_CMD(msg=1, timeLimit=120))
    runtime = time.time() - start_time
    print(f"status: {LpStatus[prob.status]} in {runtime:.1f} seconds")
    status = LpStatus[prob.status]
    if status != "Optimal":
        raise ValueError(f"Solver status: {status}")
    
    # read and translate results 
    gdf_result = gdf.copy()
    gdf_result["selected_bgi"] = None
    gdf_result["selected_bgi_area"] = 0.0
    
    for (idx, bgi), var in variables.items():
        if var.value() is not None and var.value() > 0.9:
            gdf_result.at[idx, "selected_bgi"] = bgi
            gdf_result.at[idx, "selected_bgi_area"] = area_cap[(idx, bgi)]

    return [total_theoretical_cooling, total_theoretical_retention], gdf_result

##################################################################################
# FUNCTION: FIND OPTIMUM PERFORMANCE on a budget                                           
##################################################################################
def closest_to_goal_on_budget(
    input_gdf,
    cooling_target_per_m2, 
    retention_target_per_m2,
    max_budget):

    gdf, area_cap = prepare_gdf(input_gdf)
    total_area = gdf["area_m2"].sum()
    if total_area <= 0:
        raise ValueError("invalid or missing area!!!")
        
    if cooling_target_per_m2 <= 0 or retention_target_per_m2 <= 0:
        raise ValueError("invalid targets!!! must be > 0!!!")

    if max_budget is None or max_budget <= 0: 
        raise ValueError("need a (positive) max_budget input please!")

    cooling_target_total = cooling_target_per_m2 * total_area
    retention_target_total = retention_target_per_m2 * total_area
    
    # define binary decision variables
    variables = {
        (idx, bgi): LpVariable(f"x_{idx}_{bgi}", cat="Binary")
        for (idx, bgi) in area_cap
    }

    # define the problem 
    prob = LpProblem("Minimum_Slack", LpMinimize)

    # define total cooling, retention, cost expressions
    total_optimized_cooling = lpSum(
        variables[(idx, bgi)] * area_cap[(idx, bgi)] * bgi_cooling[bgi]
        for (idx, bgi) in variables
    )

    total_optimized_retention = lpSum(
        variables[(idx, bgi)] * area_cap[(idx, bgi)] * bgi_retention[bgi]
        for (idx, bgi) in variables
    )

    total_optimized_cost = lpSum(
        variables[(idx, bgi)] * area_cap[(idx, bgi)] * bgi_capex[bgi]
        for (idx, bgi) in variables
    )

    # define slack variables
    slack_cooling = LpVariable("slack_cooling", lowBound=0)
    slack_retention = LpVariable("slack_retention", lowBound=0) 
    
    # constraint: 1 BGI placed per cell
    for idx in gdf.index:
        prob += lpSum(
            variables[(idx, bgi)]
            for bgi in gdf.at[idx, "suitable_bgis"]
            if (idx, bgi) in variables
        ) <= 1

    # constraint: budget
    prob += total_optimized_cost <= max_budget  

    # constraint: reach goal with slack
    prob += total_optimized_cooling + slack_cooling >= cooling_target_total
    prob += total_optimized_retention + slack_retention >= retention_target_total
    
    # objective: minimize slack (small cost expression included for tie-breaking when needed)
    prob += (slack_cooling/cooling_target_total 
             + slack_retention/retention_target_total 
             + 1e-9 * total_optimized_cost/max_budget 
            )
    
    # solve
    start_time = time.time()
    prob.solve(PULP_CBC_CMD(msg=1, timeLimit=120))
    runtime = time.time() - start_time
    print(f"status: {LpStatus[prob.status]} in {runtime:.1f} seconds")
    status = LpStatus[prob.status]
    if status != "Optimal":
        raise ValueError(f"Solver status: {status}")
        
    # read and translate results
    gdf_result = gdf.copy()
    gdf_result["selected_bgi"] = None
    gdf_result["selected_bgi_area"] = 0.0
    gdf_result["selected_capex"] = 0.0

    for (idx, bgi), var in variables.items():
        if var.value() is not None and var.value() > 0.9:
            gdf_result.at[idx, "selected_bgi"] = bgi
            gdf_result.at[idx, "selected_bgi_area"] = area_cap[(idx, bgi)]
            gdf_result.at[idx, "selected_capex"] = (
                bgi_capex.get(bgi, 0) * area_cap[(idx, bgi)]
            )
    
    return gdf_result

