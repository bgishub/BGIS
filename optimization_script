        ) <= 1

    # constraint: reach goals
    prob += total_optimized_cooling >= cooling_target_total
    prob += total_optimized_retention >= retention_target_total

    # objective: minimize cost
    prob += total_optimized_cost  

    # solve
    start_time = time.time()
